---
const title = "The authority puzzle · an unfolding study";
const description =
  "Unfold the layers. Evidence can strengthen a claim without permitting an action. Permission can exist without proving the claim that motivated it.";
const canonical = "https://press.mazzeleczzare.com/authority-puzzle/";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<style is:global>
:root{--paper:#f4f1e9;--ink:#242622;--muted:#62665d;--lime:#d9ff43;--line:#c9c8bd}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 system-ui,sans-serif}main{max-width:1060px;margin:auto;padding:62px 24px 80px}.eyebrow{font:11px/1.4 monospace;letter-spacing:.15em;text-transform:uppercase}h1{font:clamp(42px,7vw,82px)/1.02 Georgia,serif;letter-spacing:-.04em;max-width:820px;margin:22px 0}h2{font:32px/1.1 Georgia,serif;margin:10px 0 20px}h3{font-size:16px;margin:0 0 8px}p{max-width:720px}mark{background:var(--lime);color:var(--ink);padding:0 .18em}.intro{font-size:19px;max-width:700px}.toolbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:30px 0 22px}button{font:inherit;border:1px solid var(--ink);background:transparent;padding:10px 16px;cursor:pointer;color:inherit}button:hover{background:var(--ink);color:var(--paper)}button:focus-visible,summary:focus-visible,input:focus-visible{outline:3px solid #697d00;outline-offset:5px}.progress{font:12px monospace;margin-left:auto}.spine{border-left:1px dashed var(--muted);padding-left:22px}.fold{position:relative;border:1px solid var(--line);margin:0 0 15px;background:#faf8f2;box-shadow:3px 4px 0 #deddd3}.fold:before{content:'';position:absolute;left:-28px;top:30px;width:10px;height:10px;background:var(--ink);transform:rotate(45deg)}summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:44px 1fr 30px;align-items:center;gap:10px;padding:20px}summary::-webkit-details-marker{display:none}.num{font:12px monospace;color:var(--muted)}.title{font-size:20px}.hint{display:block;color:var(--muted);font:12px/1.5 monospace;margin-top:3px}.plus{font-size:25px;transition:transform .35s}details[open] .plus{transform:rotate(45deg)}.sheet{border-top:1px dashed var(--line);padding:28px 30px;transform-origin:top;animation:unfold .55s cubic-bezier(.2,.65,.3,1) both;background:linear-gradient(165deg,#fffdf7 0%,#f4f1e9 85%)}@keyframes unfold{from{opacity:0;transform:perspective(1000px) rotateX(-24deg) translateY(-12px)}to{opacity:1;transform:perspective(1000px) rotateX(0) translateY(0)}}.split{display:grid;grid-template-columns:1fr 1fr;gap:25px}.boundary{background:var(--ink);color:var(--paper);padding:17px 20px;margin:22px 0 0;font-size:15px}.boundary mark{white-space:normal}.band{height:7px;background:linear-gradient(90deg,#f24c79 0 20%,#ffad39 20% 40%,#d9ff43 40% 60%,#3dbfcd 60% 80%,#8664ed 80%)}.micro{font:12px/1.6 monospace;color:var(--muted)}.token{display:inline-block;border:1px solid var(--line);padding:3px 8px;margin:3px 3px 3px 0;font:12px monospace}.formula{font:clamp(17px,3vw,24px)/1.5 monospace;margin:20px 0;overflow-wrap:anywhere}.inset{margin-top:20px;border-top:1px solid var(--line)}.inset summary{padding:15px 0;display:block;font-size:14px}.inset .sheet{padding:15px 0;animation:none;background:none}.gate{margin-top:40px;background:var(--ink);color:var(--paper)}.gate-inner{padding:30px}.gate .micro{color:#c5c7bb}.controls{display:grid;gap:12px;margin:23px 0}.controls label{display:flex;align-items:start;gap:12px}input{accent-color:var(--lime);width:19px;height:19px;flex-shrink:0;margin-top:3px}.readout{border:1px solid #787b70;padding:20px;margin-top:20px}.readout p{margin:8px 0}.status{color:var(--lime);font:14px monospace}.foot{margin-top:30px;border-top:1px solid var(--line);padding-top:20px;font-size:13px;color:var(--muted)}.shell-note{margin:0 0 18px;font:11px/1.5 monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.shell-note a{color:inherit}@media(max-width:650px){main{padding:32px 17px}.split{grid-template-columns:1fr}.sheet{padding:22px 18px}.spine{padding-left:15px}.fold:before{left:-21px}summary{padding:16px;grid-template-columns:28px 1fr 20px}.progress{margin-left:0}.gate-inner{padding:22px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}@media print{button,.controls{display:none}.sheet{animation:none}body{background:white}.fold,.gate{break-inside:avoid}.gate{background:#eee;color:#222}.status{color:#222}}
</style>
</head>
<body>
<main>
<p class="shell-note">Trusted Astro shell · sealed by Rustpress · <a href="/">not corpus-sealed prose</a></p>
<div class="eyebrow">frontier-digest / design workshop / interactive boundary study</div>
<h1>The authority puzzle<br>is not a ladder.</h1>
<p class="intro">Unfold the layers. Each answers a different question. <mark>No fold grants the next one.</mark></p>
<p>Evidence can strengthen a claim without permitting an action. Permission can exist without proving the claim that motivated it.</p>
<div class="toolbar">
<button type="button" id="next">Unfold next</button>
<button type="button" id="back">Fold back</button>
<button type="button" id="reset">Refold all</button>
<span class="progress" aria-live="polite" id="progress">0 / 5 layers open</span>
</div>
<div class="spine">
<details class="fold"><summary><span class="num">01</span><span class="title">Observation<span class="hint">What was captured?</span></span><span class="plus" aria-hidden="true">+</span></summary><div class="sheet"><h2>A trace, not the thing itself.</h2><div class="split"><div><h3>Preserve</h3><p>The captured paper or report, raw hash, canonical metadata, provenance, and capture time.</p><span class="token">source observation</span><span class="token">content identity</span></div><div><h3>Limit</h3><p>Changed bytes establish a changed capture—not necessarily a changed scientific claim. A snapshot does not establish truth.</p></div></div><div class="boundary">Capture ≠ truth. Preservation ≠ publication permission.</div><details class="inset"><summary>Unfold an example ↗</summary><div class="sheet"><p>A report is captured twice with different hashes. The observation history records the difference. Whether the result changed remains a separate interpretive question.</p></div></details></div></details>
<details class="fold"><summary><span class="num">02</span><span class="title">Human ruling<span class="hint">What did you judge, and within what scope?</span></span><span class="plus" aria-hidden="true">+</span></summary><div class="sheet"><h2>Authored judgment survives regeneration.</h2><div class="split"><div><h3>Preserve</h3><p>A claim target, verdict, reason, evidence binding, scope, and history. Affirmed, rejected, uncertain, and superseded remain distinct.</p></div><div><h3>Limit</h3><p>A binding establishes traceability. An affirmation records judgment. Neither automatically confers universal verification.</p></div></div><div class="boundary">An inspected passage + an affirmation <mark>does not equal unlimited verification.</mark></div><details class="inset"><summary>Unfold an example ↗</summary><div class="sheet"><p>“Affirmed for the reported evaluation; not established for deployment.” A later ruling may supersede this judgment without erasing it. Stale targets remain visible.</p></div></details></div></details>
<details class="fold"><summary><span class="num">03</span><span class="title">Bearing · claim laboratory<span class="hint">How does the claim stand under a declared evidence policy?</span></span><span class="plus" aria-hidden="true">+</span></summary><div class="band"></div><div class="sheet"><h2>Different ways of knowing.<br>Not a vote count for truth.</h2><p>Bearing evaluates the ledger at a read-point, with an active frame configuration and an explicit policy.</p><div class="formula">Bₜ(c) = Fold_B(L≤ₜ, F_active, π)</div><div><span class="token">implementation</span><span class="token">formal-semantics</span><span class="token">external-literature</span><span class="token">adversarial-evaluation</span><span class="token">replication</span><span class="token">normative-review</span></div><p>Technicolor marks different methods of inquiry—not six interchangeable endorsements. Distinct tags do not by themselves establish independent support.</p><div class="boundary"><mark>robust(c) ⇏ true(c)</mark><br>Contradictions remain visible; they are not silently deducted from a score.</div><details class="inset"><summary>Unfold the proposed policy and independence rules ↗</summary><div class="sheet"><p>As described in the workshop: an explicit refute event yields <em>refuted</em>; otherwise two or more active supporting frames yield <em>robust</em>, one yields <em>fragile</em>, and zero yields <em>gone</em>. This threshold is a policy, not an epistemic theorem.</p><p>A tested-by relation contributes only when its applicable latest check outcome is held.</p><ul><li>Multiple files in one component remain one implementation neighborhood.</li><li>Formal derivations must do more than restate implementation comments.</li><li>One paper cannot manufacture several independent frames.</li><li>Adversarial tests use predeclared operators and observable oracles.</li><li>Replication must not share the tested decision logic.</li><li>Author-originated judgment remains provenance, not automatically independent normative support.</li></ul></div></details></div></details>
<details class="fold"><summary><span class="num">04</span><span class="title">Governing policy · explicit bridge<span class="hint">What conditions must this action satisfy?</span></span><span class="plus" aria-hidden="true">+</span></summary><div class="sheet"><h2>A gate, not an inference.</h2><p>A governing policy may make a Bearing result one prerequisite for a particular action. The policy must explicitly establish that dependency. A change in evidentiary standing alone does not grant or revoke capability.</p><div class="split"><div><h3>Stratum</h3><p>The system of record for durable operational decisions and their governing basis.</p></div><div><h3>Stele</h3><p>Defines enforceable policy. It does not narrate personal meaning or turn research standing into permission by implication.</p></div></div><div class="boundary">“The claim is robust” is not an authorization rule.</div><details class="inset"><summary>Unfold a hypothetical bridge ↗</summary><div class="sheet"><p>“For this named action, require an existing scoped capability, a valid governing basis, and a robust Bearing result.” This is an illustrative rule only—not a proposed default policy or a live grant.</p></div></details></div></details>
<details class="fold"><summary><span class="num">05</span><span class="title">Runtime authority<span class="hint">What may the agent do, and on what basis?</span></span><span class="plus" aria-hidden="true">+</span></summary><div class="band"></div><div class="sheet"><h2>Permission has its own type.</h2><div class="formula">A(x) = (g, b)</div><p>Here, <em>g</em> denotes governing capability and <em>b</em> the basis under which it was obtained. This is separate from the standing of a research claim.</p><div class="boundary"><mark>robust(c) ⇏ authorized(x)</mark><br>authorized(x) ⇏ true(c)</div><p>The interpreter remains accountable for the direction chosen. No evidence fold takes custody of that responsibility.</p></div></details>
</div>
<section class="gate" aria-labelledby="lab-title"><div class="band"></div><div class="gate-inner"><div class="eyebrow">Counterexample bench / local simulation only</div><h2 id="lab-title">Try to cross the boundary.</h2><p>Change the inputs. The illustrative policy always requires a scoped capability and valid basis. You can separately choose whether it requires robust evidence.</p><div class="controls"><label><input type="checkbox" id="evidence" />The research claim is robust under the declared Bearing policy.</label><label><input type="checkbox" id="capability" />A scoped capability for this action exists.</label><label><input type="checkbox" id="basis" />Its governing basis is valid for this action.</label><label><input type="checkbox" id="require" />The explicit policy also requires robust evidence.</label></div><div class="readout" aria-live="polite" aria-atomic="true"><div class="status" id="status"></div><p id="reason"></p><p id="standing"></p></div><p class="micro">Boolean illustration, not a Stratum evaluator. No grants, decisions, or events are written. “Not robust” here does not distinguish fragile, gone, or refuted. Governing-basis validity is an assumed input, not computed by this page.</p></div></section>
<footer class="foot"><p>Workshop artifact · based solely on the supplied conversation · no repository audit or implementation verification implied.</p><p>Trusted Astro shell page, sealed with the pressing by Rustpress. Refolding changes only this view; it does not erase a ledger.</p></footer>
</main>
<script is:inline>
const folds=[...document.querySelectorAll('.spine > details')];
function progress(){document.getElementById('progress').textContent=folds.filter(x=>x.open).length+' / 5 layers open';}
folds.forEach(x=>x.addEventListener('toggle',progress));
document.getElementById('next').onclick=()=>{const x=folds.find(x=>!x.open);if(x){x.open=true;x.querySelector('summary').focus();}};
document.getElementById('back').onclick=()=>{const x=[...folds].reverse().find(x=>x.open);if(x){x.open=false;x.querySelector('summary').focus();}};
document.getElementById('reset').onclick=()=>{document.querySelectorAll('details').forEach(x=>x.open=false);};
const ids=['evidence','capability','basis','require'];
function evaluate(){const [e,c,b,r]=ids.map(id=>document.getElementById(id).checked);const allowed=c&&b&&(!r||e);document.getElementById('status').textContent=allowed?'ILLUSTRATIVE RULE: SATISFIED':'ILLUSTRATIVE RULE: NOT SATISFIED';const missing=[];if(!c)missing.push('scoped capability');if(!b)missing.push('valid governing basis');if(r&&!e)missing.push('policy-required robust evidence');document.getElementById('reason').textContent=allowed?'The selected inputs satisfy this toy rule. This page grants no runtime authority.':'Missing: '+missing.join('; ')+'. Evidence alone cannot supply a capability or its basis.';document.getElementById('standing').textContent=e?'Claim standing: robust under the selected policy—not established as true.':'Claim standing: not robust in this simplified example—not established as false.';}
ids.forEach(id=>document.getElementById(id).addEventListener('change',evaluate));evaluate();
</script>
</body>
</html>
